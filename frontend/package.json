    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.13.0",
    "i18next-scanner": "^4.6.0",
    "i18next-scanner-typescript": "^1.2.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "openapi-typescript-helpers": "^0.1.0",
