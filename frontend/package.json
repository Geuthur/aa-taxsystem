    "@tanstack/react-table": "^8.21.3",
    "apexcharts": "^7.1.0",
    "csv-stringify": "^6.8.3",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^4.0.2",
    "js-cookie": "^3.0.8",
    "lucide-react": "^0.546.0",
    "nuqs": "^2.10.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-apexcharts": "^2.1.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.9.6"
