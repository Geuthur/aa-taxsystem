{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "buildTranslations": "npx i18next-scanner --config i18next-scanner.config.cjs",
