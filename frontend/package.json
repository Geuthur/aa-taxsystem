{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "buildTranslations": "npx i18next-scanner --config i18next-scanner.config.cjs",
    "generate-api": "openapi-typescript ./src/openapi.json -o src/Api/OpenApi.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
