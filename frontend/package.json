    "i18next": "^26.5.11",
    "i18next-http-backend": "^4.0.6",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.64.0",
    "nuqs": "^2.10.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-apexcharts": "^2.1.2",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5"
